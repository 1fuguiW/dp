@startuml
' 设置类图属性图标（使用标准的 + - # 符号而不是图形）
skinparam classAttributeIconSize 0
' 设置排版方向为从上到下
top to bottom direction

' 1. 产品类
class SetMeal {
    - soup : String
    - rice : String
    - snack : String
    + setSoup(soup : String) : void
    + setRice(rice : String) : void
    + setSnack(snack : String) : void
    + showMeal() : void
}

' 2. 抽象建造者接口
interface Chef <<interface>> {
    + initSetMeal() : void
    + buildSoup() : void
    + buildRice() : void
    + buildSnack() : void
    + getSetMeal() : SetMeal
}

' 3. 具体建造者
class Chef1 {
    - setMeal : SetMeal
    + initSetMeal() : void
    + buildSoup() : void
    + buildRice() : void
    + buildSnack() : void
    + getSetMeal() : SetMeal
}

class Chef2 {
    - setMeal : SetMeal
    + initSetMeal() : void
    + buildSoup() : void
    + buildRice() : void
    + buildSnack() : void
    + getSetMeal() : SetMeal
}

' 4. 指挥者
class Waiter {
    - chef : Chef
    + setChef(chef : Chef) : void
    + constructMeal() : SetMeal
}

' 5. 客户端代码
class Main {
    + main(args : String[]) : void
}

' ====================
' 定义类与类之间的关系连线
' ====================

' 实现接口 (虚线 + 空心三角箭头)
Chef <|.. Chef1
Chef <|.. Chef2

' 聚合关系 (实线 + 空心菱形)，服务员包含厨师引用
Waiter o--> Chef : 聚合

' 关联关系 (实线 + 箭头)，具体厨师创建出具体的套餐对象
Chef1 --> SetMeal : 制造
Chef2 --> SetMeal : 制造

' 依赖关系 (虚线 + 箭头)，Main 方法运行需要用到服务员和具体厨师
Main ..> Waiter : 依赖
Main ..> Chef1 : 依赖
Main ..> Chef2 : 依赖

@enduml